#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# 🚀 Pre-commit code quality checks

echo "🔍 Starting pre-commit checks..."

# TypeScript compile check (whole project)
echo "📝 Checking TypeScript compilation..."
npm run compile
if [ $? -ne 0 ]; then
  echo "❌ TypeScript compilation failed, commit blocked"
  exit 1
fi

# Format and lint staged files
echo "🧹 Checking format and quality of staged files..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo "❌ Code format or quality check failed, commit blocked"
  exit 1
fi
